<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ============================================================= -->
    <!-- MedMarketTools — "Neon Red / Black" theme                     -->
    <!-- Merged AFTER WPF-UI's Dark theme so these win. Any key that   -->
    <!-- WPF-UI does not use is simply ignored.                        -->
    <!--                                                               -->
    <!-- Layout: 1) raw colors  2) WPF-UI brush overrides  3) brand    -->
    <!-- design tokens  4) reusable component styles.                  -->
    <!-- ============================================================= -->

    <!-- ============================================================= -->
    <!-- 1. Raw palette                                                -->
    <!-- ============================================================= -->
    <Color x:Key="BrandAccentColor">#FFFF2D46</Color>
    <Color x:Key="BrandAccentHoverColor">#FFFF5A6B</Color>
    <Color x:Key="BrandAccentDeepColor">#FFC1152B</Color>

    <!-- Accent color (drives the accent brushes controls bind to) -->
    <Color x:Key="SystemAccentColor">#FFFF2D46</Color>
    <Color x:Key="SystemAccentColorPrimary">#FFFF2D46</Color>
    <Color x:Key="SystemAccentColorSecondary">#FFC1152B</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF7A0D1A</Color>

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2D46" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF5A6B" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C1152B" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3DFF2D46" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF2D46" />

    <!-- ============================================================= -->
    <!-- 2. WPF-UI surface / control / text brush overrides            -->
    <!-- ============================================================= -->
    <!-- Base surfaces: deep near-black with a faint red undertone -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#070709" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#070709" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#0C0C11" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#0E0E14" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#131319" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#1A1A22" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTransparentBrush" Color="#00070709" />

    <!-- Layers / cards -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0E0E14" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#131319" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#660E0E14" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#B30E0E14" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="#08000000" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="#13131319" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" Color="#00000000" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#26FF2D46" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#33FF2D46" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#131319" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#1C1C25" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00000000" />

    <!-- Strokes / dividers -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#19FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFF2D46" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FF070709" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF4F4F7" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C9FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FF070709" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#5DFFFFFF" />

    <!-- ============================================================= -->
    <!-- 3. Brand design tokens (reusable across views)                -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#FF2D46" />
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="#FF5A6B" />
    <SolidColorBrush x:Key="BrandAccentDeepBrush" Color="#C1152B" />
    <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#2EFF2D46" />
    <SolidColorBrush x:Key="BrandAccentFaintBrush" Color="#14FF2D46" />
    <SolidColorBrush x:Key="BrandSuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="BrandWarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="BrandDangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="BrandInfoBrush" Color="#60A5FA" />

    <!-- Signature accent gradient (logo mark, hero rules, primary fills) -->
    <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#FFFF5870" />
        <GradientStop Offset="0.55" Color="#FFFF2D46" />
        <GradientStop Offset="1.0" Color="#FFB00F26" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandAccentGradientH" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#FFFF2D46" />
        <GradientStop Offset="1.0" Color="#00FF2D46" />
    </LinearGradientBrush>

    <!-- Glassy card surfaces -->
    <SolidColorBrush x:Key="BrandCardBgBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="BrandCardHoverBgBrush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="BrandCardBorderBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="BrandCardHoverBorderBrush" Color="#59FF2D46" />
    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#0EA1A1B0" />
    <SolidColorBrush x:Key="BrandSurfaceStrongBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BrandSurfaceBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BrandDividerBrush" Color="#14FFFFFF" />

    <!-- Ambient red aura used behind the app shell -->
    <RadialGradientBrush x:Key="BrandAuraBrush" Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.85" RadiusY="0.95">
        <GradientStop Offset="0.0" Color="#3AFF2D46" />
        <GradientStop Offset="0.35" Color="#1610121A" />
        <GradientStop Offset="1.0" Color="#00070709" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BrandAuraBottomBrush" Center="1.0,1.0" GradientOrigin="1.0,1.0" RadiusX="0.7" RadiusY="0.8">
        <GradientStop Offset="0.0" Color="#26A11626" />
        <GradientStop Offset="1.0" Color="#00070709" />
    </RadialGradientBrush>

    <CornerRadius x:Key="BrandCardRadius">14</CornerRadius>
    <CornerRadius x:Key="BrandControlRadius">9</CornerRadius>
    <CornerRadius x:Key="BrandPillRadius">999</CornerRadius>

    <!-- Shared elevation effects -->
    <DropShadowEffect x:Key="BrandCardShadow" BlurRadius="22" Direction="270" Opacity="0.40" ShadowDepth="4" Color="#000000" />
    <DropShadowEffect x:Key="BrandAccentGlow" BlurRadius="20" Direction="270" Opacity="0.55" ShadowDepth="0" Color="#FF2D46" />

    <!-- ============================================================= -->
    <!-- 4. Component styles                                           -->
    <!-- ============================================================= -->

    <!-- Page title / subtitle / section labels -->
    <Style x:Key="BrandPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BrandPageSubtitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Short gradient rule that sits under a page title -->
    <Style x:Key="BrandTitleRule" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="1,11,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource BrandAccentGradient}" />
    </Style>
    <Style x:Key="BrandSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- Small uppercase grey label above a card -->
    <Style x:Key="BrandSectionLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,22,0,8" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#8AFFFFFF" />
    </Style>

    <!-- Thin 1px divider -->
    <Style x:Key="BrandDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BrandDividerBrush}" />
        <Setter Property="Margin" Value="14,0" />
    </Style>

    <!-- Small rounded "pill" / badge -->
    <Style x:Key="BrandPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="#40FF2D46" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BrandPillRadius}" />
        <Setter Property="Padding" Value="9,3" />
    </Style>

    <!-- Square rounded icon badge -->
    <Style x:Key="BrandIconBadge" TargetType="Border">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource BrandAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="#3DFF2D46" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Elevated glass surface (static) -->
    <Style x:Key="BrandInfoCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BrandCardRadius}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Grouped settings/section card -->
    <Style x:Key="BrandSectionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BrandCardRadius}" />
    </Style>

    <!-- Card as a Button: whole surface clickable, hover brightens + red rim + lift -->
    <Style x:Key="BrandCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="B"
                        Padding="16,14"
                        Background="{StaticResource BrandCardBgBrush}"
                        BorderBrush="{StaticResource BrandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BrandCardRadius}"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource BrandCardHoverBgBrush}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BrandCardHoverBorderBrush}" />
                            <Setter TargetName="B" Property="Effect" Value="{StaticResource BrandCardShadow}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cover/recent card: fixed width, image on top, whole card clickable -->
    <Style x:Key="BrandRecentCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="B"
                        Width="172"
                        Background="{StaticResource BrandCardBgBrush}"
                        BorderBrush="{StaticResource BrandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BrandCardRadius}"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource BrandCardHoverBgBrush}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BrandCardHoverBorderBrush}" />
                            <Setter TargetName="B" Property="Effect" Value="{StaticResource BrandCardShadow}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent row used inside info cards -->
    <Style x:Key="BrandStatusRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="B"
                        Padding="8,6"
                        Background="Transparent"
                        CornerRadius="{StaticResource BrandControlRadius}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
