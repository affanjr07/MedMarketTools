<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- MedMarketTools — Neon Red / Black theme                       -->
    <!-- Merged AFTER WPF-UI's Dark theme so these win. Any key that   -->
    <!-- WPF-UI does not use is simply ignored.                        -->
    <!-- ============================================================= -->

    <!-- Accent color (drives the accent brushes controls bind to) -->
    <Color x:Key="SystemAccentColor">#FFE01F2D</Color>
    <Color x:Key="SystemAccentColorPrimary">#FFE01F2D</Color>
    <Color x:Key="SystemAccentColorSecondary">#FFB0141F</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF7A0D15</Color>

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E01F2D" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F0323F" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B0141F" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3DE01F2D" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#E01F2D" />

    <!-- Base surfaces: near-black with a faint red undertone -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#08080A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#08080A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#0D0D10" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#0F0F12" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#141418" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#1A1A20" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTransparentBrush" Color="#0008080A" />

    <!-- Layers / cards -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0F0F12" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#141418" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#660F0F12" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#B30F0F12" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="#08000000" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="#13141418" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" Color="#00000000" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#26E01F2D" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#33E01F2D" />

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#141418" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#1C1C22" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00000000" />

    <!-- Strokes / dividers -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#19FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFE01F2D" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FF08080A" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C7FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FF08080A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#5DFFFFFF" />

    <!-- ============================================================= -->
    <!--  Brand design tokens (reusable across views)                  -->
    <!-- ============================================================= -->
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#E01F2D" />
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="#F0323F" />
    <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="#33E01F2D" />
    <SolidColorBrush x:Key="BrandSuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="BrandDangerBrush" Color="#F87171" />

    <SolidColorBrush x:Key="BrandCardBgBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="BrandCardHoverBgBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="BrandCardBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BrandCardHoverBorderBrush" Color="#4DE01F2D" />

    <CornerRadius x:Key="BrandCardRadius">12</CornerRadius>
    <CornerRadius x:Key="BrandControlRadius">8</CornerRadius>

    <!-- Card as a Button: whole surface clickable, hover brightens + red rim -->
    <Style x:Key="BrandCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="B"
                        Padding="16,14"
                        Background="{StaticResource BrandCardBgBrush}"
                        BorderBrush="{StaticResource BrandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BrandCardRadius}"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource BrandCardHoverBgBrush}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BrandCardHoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cover/recent card: fixed width, image on top, whole card clickable -->
    <Style x:Key="BrandRecentCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="B"
                        Width="170"
                        Background="{StaticResource BrandCardBgBrush}"
                        BorderBrush="{StaticResource BrandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource BrandCardRadius}"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource BrandCardHoverBgBrush}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource BrandCardHoverBorderBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent row used inside info cards -->
    <Style x:Key="BrandStatusRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="B"
                        Padding="6,5"
                        Background="Transparent"
                        CornerRadius="{StaticResource BrandControlRadius}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Static info card surface -->
    <Style x:Key="BrandInfoCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource BrandCardRadius}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
</ResourceDictionary>
