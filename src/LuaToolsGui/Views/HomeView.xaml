<UserControl
    x:Class="LuaToolsGui.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
    <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="24,20,24,32">

            <!-- Greeting -->
            <TextBlock Style="{StaticResource BrandPageTitle}" Text="{x:Static res:Strings.Home_Welcome}" />
            <Border Style="{StaticResource BrandTitleRule}" />

            <!-- Stat tiles (clickable) -->
            <UniformGrid Margin="0,22,0,0" Columns="2" Rows="1">
                <!-- Luas on board → Manage -->
                <Button Margin="0,0,7,0" Command="{Binding OpenManageCommand}" Style="{StaticResource BrandCardButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BrandIconBadge}" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                FontSize="20"
                                Foreground="{StaticResource BrandAccentBrush}"
                                Symbol="Games24" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandAccentBrush}"
                                Text="{Binding GameCount}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{x:Static res:Strings.Home_LuasOnBoard}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <!-- Plugin status → Plugin page (+ inline Install when not installed) -->
                <Button Margin="7,0,0,0" Command="{Binding OpenPluginCommand}" Style="{StaticResource BrandCardButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BrandIconBadge}" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                FontSize="20"
                                Foreground="{StaticResource BrandAccentBrush}"
                                Symbol="PuzzlePiece24" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{x:Static res:Strings.Home_PluginStatus}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{Binding PluginStatusColor}"
                                Text="{Binding PluginStatusText}"
                                TextTrimming="CharacterEllipsis" />
                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Padding="12,4"
                                Appearance="Primary"
                                Command="{Binding InstallPluginCommand}"
                                Content="{x:Static res:Strings.Plugin_Btn_Install}"
                                IsEnabled="{Binding NotInstallingPlugin}"
                                Visibility="{Binding ShowPluginInstall, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Status: Steam + account + mode -->
            <Border Margin="0,16,0,0" Padding="7" Style="{StaticResource BrandInfoCard}">
                <StackPanel>
                    <!-- Steam → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource BrandStatusRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="28"
                                Height="28"
                                Background="#14FFFFFF"
                                CornerRadius="8">
                                <ui:SymbolIcon
                                    FontSize="15"
                                    Symbol="Games24">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{StaticResource BrandDangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SteamFound}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrandSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SteamStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource BrandDivider}" />

                    <!-- Account → Settings -->
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource BrandStatusRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="28"
                                Height="28"
                                Background="{StaticResource BrandAccentSoftBrush}"
                                CornerRadius="8">
                                <ui:SymbolIcon
                                    FontSize="15"
                                    Foreground="{StaticResource BrandAccentBrush}"
                                    Symbol="Person24" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding AccountStatus}" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource BrandDivider}" />

                    <!-- Active mode → Mode -->
                    <Button Command="{Binding OpenModeCommand}" Style="{StaticResource BrandStatusRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="28"
                                Height="28"
                                Background="{StaticResource BrandAccentSoftBrush}"
                                CornerRadius="8">
                                <ui:SymbolIcon
                                    FontSize="15"
                                    Foreground="{StaticResource BrandAccentBrush}"
                                    Symbol="Options24" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ModeStatus}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Drag-and-drop install -->
            <views:DropZone Margin="0,16,0,0" DataContext="{Binding Drop}" />

            <!-- Recently added -->
            <StackPanel Margin="0,26,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BrandSectionTitle}" Text="{x:Static res:Strings.Home_RecentlyAdded}" />
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,13,13"
                                Command="{Binding DataContext.OpenGameCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource BrandRecentCardButton}"
                                ToolTip="{x:Static res:Strings.Home_ViewDetails}">
                                <StackPanel>
                                    <Border
                                        Height="84"
                                        Background="#11FFFFFF"
                                        ClipToBounds="True"
                                        CornerRadius="14,14,0,0">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        Margin="11,9,11,11"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- Drag-and-drop overwrite confirm (the DropZone's own flow), page-spanning. -->
    <views:ConfirmOverlay DataContext="{Binding Drop}" />
    </Grid>
</UserControl>
