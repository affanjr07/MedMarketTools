<UserControl
    x:Class="LuaToolsGui.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Segmented Yes/No button: Primary when its bound bool matches this button's value. -->
        <Style x:Key="ChoiceButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Dim scrim + centered welcome card (in-window overlay, not a Popup). Visibility is controlled by
         the host in MainWindow via Onboarding.IsOpen. -->
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#B8000000" />
        </Grid.Background>

        <!-- Red aura glowing behind the card -->
        <Ellipse
            Width="720"
            Height="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{StaticResource BrandAuraBrush}"
            IsHitTestVisible="False" />

        <Border
            MaxWidth="620"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#14141B"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{StaticResource BrandCardShadow}">
            <StackPanel>
                <!-- Accent strip along the top edge -->
                <Border
                    Height="4"
                    Background="{StaticResource BrandAccentGradient}"
                    CornerRadius="20,20,0,0" />

                <StackPanel Margin="30,24,30,28">
                    <!-- Brand row -->
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="40"
                            Height="40"
                            Background="{StaticResource BrandAccentGradient}"
                            CornerRadius="12"
                            Effect="{StaticResource BrandAccentGlow}">
                            <Image Margin="6" Source="pack://application:,,,/icon.ico" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandAccentBrush}"
                                Text="MedMarketTools" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="FIRST-RUN SETUP" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Title -->
                    <TextBlock
                        Margin="0,20,0,0"
                        FontSize="23"
                        FontWeight="Bold"
                        Text="{x:Static res:Strings.Onboarding_Title}"
                        TextWrapping="Wrap" />

                    <!-- Sign in (guest only) -->
                    <Border
                        Margin="0,18,0,0"
                        Padding="16,14"
                        Background="{StaticResource BrandCardBgBrush}"
                        BorderBrush="{StaticResource BrandCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    FontSize="17"
                                    Foreground="{StaticResource BrandAccentBrush}"
                                    Symbol="Person24" />
                                <TextBlock
                                    Margin="9,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Text="{x:Static res:Strings.Onboarding_SignIn_Blurb}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Appearance="Primary"
                                Command="{Binding SignInCommand}"
                                Content="{x:Static res:Strings.Nav_SignInDiscord}"
                                Icon="{ui:SymbolIcon Person24}"
                                Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}" />
                            <!-- Signing-in spinner -->
                            <StackPanel
                                Margin="0,12,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{x:Static res:Strings.Nav_WaitingForBrowser}" />
                            </StackPanel>
                            <!-- Sign-in error -->
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="11.5"
                                Foreground="{StaticResource BrandDangerBrush}"
                                Text="{Binding StatusLine}"
                                TextWrapping="Wrap"
                                Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Border>
                    <!-- Signed-in confirmation -->
                    <StackPanel
                        Margin="0,18,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon
                            FontSize="18"
                            Foreground="{StaticResource BrandSuccessBrush}"
                            Symbol="CheckmarkCircle24" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrandSuccessBrush}"
                            Text="{x:Static res:Strings.Onboarding_SignedIn}" />
                    </StackPanel>

                    <Border Height="1" Margin="0,22,0,0" Background="{StaticResource BrandDividerBrush}" />

                    <!-- Apply recommended settings -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboarding_Recommended_Title}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static res:Strings.Onboarding_Recommended_Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                                <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ApplyRecommended}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Command="{Binding SetApplyRecommendedCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                                <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ApplyRecommended}" Value="False">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Install plugin -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,28,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboarding_Plugin_Title}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static res:Strings.Onboarding_Plugin_Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_Yes}">
                                <ui:Button.CommandParameter><sys:Boolean>True</sys:Boolean></ui:Button.CommandParameter>
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstallPlugin}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Command="{Binding SetInstallPluginCommand}" Content="{x:Static res:Strings.Onboarding_No}">
                                <ui:Button.CommandParameter><sys:Boolean>False</sys:Boolean></ui:Button.CommandParameter>
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource ChoiceButton}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstallPlugin}" Value="False">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Let's go! -->
                    <ui:Button
                        Margin="0,26,0,0"
                        Padding="0,11"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding FinishCommand}"
                        Content="{x:Static res:Strings.Onboarding_Go}"
                        FontSize="14"
                        IsEnabled="{Binding NotBusy}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
